<?xml version="1.0"?>
<robot name="bpx">
  <link name="base_link" />
  <joint name="base_to_torso" type="fixed">
    <parent link="base_link" />
    <child link="torso" />
  </joint>
  <link name="livox_frame">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 3.14159265359" />
      <geometry>
        <mesh filename="package://dog_description/simply_mesh/mid360.obj" />
      </geometry>
      <material name="livox_mid360">
        <color rgba="0.28 0.30 0.32 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.017" rpy="1.5707963 0 0" />
      <geometry>
        <box size="0.065 0.065 0.06" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.017" rpy="1.5707963 0 0" />
      <mass value="0.265" />
      <inertia ixx="0.000172802" ixy="0" ixz="0" iyy="0.000172802" iyz="0" izz="0.000186604" />
    </inertial>
  </link>
  <joint name="torso_to_livox" type="fixed">
    <parent link="torso" />
    <child link="livox_frame" />
    <origin xyz="0.25 0 0.12" rpy="0 0.523599 0" />
  </joint>
  <link name="livox_imu" />
  <joint name="livox_to_imu" type="fixed">
    <parent link="livox_frame" />
    <child link="livox_imu" />
    <!-- Stationary gravity calibration: roll +0.854 deg, pitch -0.792 deg. -->
    <origin xyz="0.011 0.02329 -0.04412" rpy="0.014905 -0.013823 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0.012525 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02505 0.09 0.025" />
      </geometry>
      <material name="realsense_aluminum">
        <color rgba="0.38 0.40 0.42 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.02555 0.025 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius="0.006" length="0.001" />
      </geometry>
      <material name="realsense_lens">
        <color rgba="0.025 0.03 0.035 1" />
