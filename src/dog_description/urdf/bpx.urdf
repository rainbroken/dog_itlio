      <geometry>
        <box size="0.02505 0.09 0.025" />
      </geometry>
    </collision>
  </link>
  <joint name="livox_to_camera" type="fixed">
    <parent link="livox_frame" />
    <child link="camera_link" />
    <!-- <origin xyz="0.055 0 -0.03" rpy="0 0 0" /> -->
    <origin xyz="0.094303 0.0325 -0.029908" rpy="0 -0.5236 0" /> 
